@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
}

<div class="space-y-6">
    <section class="grid grid-cols-1 sm:grid-cols-2 xl:grid-cols-5 gap-4">
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Produtos ativos</p>
            <div id="totalProdutos" class="text-3xl font-extrabold text-slate-900 mt-2">0</div>
        </div>
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Estoque baixo</p>
            <div id="estoqueBaixo" class="text-3xl font-extrabold text-amber-600 mt-2">0</div>
        </div>
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Esgotados</p>
            <div id="produtosEsgotados" class="text-3xl font-extrabold text-red-600 mt-2">0</div>
        </div>
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Movimentações</p>
            <div id="totalMovimentacoes" class="text-3xl font-extrabold text-blue-600 mt-2">0</div>
        </div>
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Valor em estoque</p>
            <div id="valorTotalEstoque" class="text-2xl font-extrabold text-emerald-600 mt-3">R$ 0,00</div>
        </div>
    </section>

    <section class="grid grid-cols-1 xl:grid-cols-[1.2fr_.8fr] gap-6">
        <div class="app-card p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-extrabold text-slate-900">Alertas de estoque</h2>
                <i class="fa fa-triangle-exclamation text-amber-500"></i>
            </div>
            <div id="listaAlertas" class="space-y-3"></div>
        </div>

        <div class="app-card p-5">
            <div class="flex items-center justify-between mb-4">
                <h2 class="text-lg font-extrabold text-slate-900">Próximas cirurgias</h2>
                <i class="fa fa-calendar-check text-blue-600"></i>
            </div>
            <div id="listaCirurgias" class="space-y-3"></div>
        </div>
    </section>

    <section class="grid grid-cols-1 xl:grid-cols-2 gap-6">
        <div class="app-card p-5">
            <h2 class="text-lg font-extrabold text-slate-900 mb-4">Produtos por categoria</h2>
            <div class="h-80"><canvas id="graficoCategorias"></canvas></div>
        </div>
        <div class="app-card p-5">
            <h2 class="text-lg font-extrabold text-slate-900 mb-4">Entradas x Saídas</h2>
            <div class="h-80"><canvas id="graficoMovimentacoes"></canvas></div>
        </div>
    </section>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script>
    let graficoCategorias = null;
    let graficoMovimentacoes = null;

    carregarDashboard();

    async function carregarDashboard() {
        const response = await apiFetch(`${API}/relatorios/dashboard`);
        if (!response.ok) {
            toast("Erro ao carregar dashboard.", "error");
            return;
        }

        const dados = await response.json();
        preencherCards(dados);
        renderizarAlertas(dados.alertas || []);
        renderizarCirurgias(dados.proximasCirurgias || []);
        desenharCategorias(dados.produtosPorCategoria || []);
        desenharMovimentacoes(dados.entradas || 0, dados.saidas || 0);
    }

    function preencherCards(dados) {
        document.getElementById("totalProdutos").innerText = dados.totalProdutos;
        document.getElementById("estoqueBaixo").innerText = dados.estoqueBaixo;
        document.getElementById("produtosEsgotados").innerText = dados.produtosEsgotados;
        document.getElementById("totalMovimentacoes").innerText = dados.totalMovimentacoes;
        document.getElementById("valorTotalEstoque").innerText = Number(dados.valorTotalEstoque || 0).toLocaleString("pt-BR", { style: "currency", currency: "BRL" });
    }

    function renderizarAlertas(alertas) {
        const lista = document.getElementById("listaAlertas");
        lista.innerHTML = "";

        if (alertas.length === 0) {
            lista.innerHTML = `<div class="rounded-2xl bg-emerald-50 text-emerald-700 p-4 font-bold">Nenhum alerta no momento.</div>`;
            return;
        }

        alertas.slice(0, 8).forEach(p => {
            const esgotado = p.quantidade <= 0;
            lista.innerHTML += `
                <div class="rounded-2xl border ${esgotado ? "border-red-200 bg-red-50" : "border-amber-200 bg-amber-50"} p-4">
                    <div class="flex items-center justify-between gap-3">
                        <div>
                            <div class="font-extrabold ${esgotado ? "text-red-700" : "text-amber-700"}">${p.nome}</div>
                            <div class="text-xs text-slate-500">${p.categoria} · mínimo ${p.estoqueMinimo}</div>
                        </div>
                        <div class="text-xl font-extrabold ${esgotado ? "text-red-700" : "text-amber-700"}">${p.quantidade} ${p.unidadeMedida}</div>
                    </div>
                </div>`;
        });
    }

    function renderizarCirurgias(cirurgias) {
        const lista = document.getElementById("listaCirurgias");
        lista.innerHTML = "";

        if (cirurgias.length === 0) {
            lista.innerHTML = `<div class="rounded-2xl bg-slate-50 text-slate-500 p-4 font-bold">Sem cirurgias próximas.</div>`;
            return;
        }

        cirurgias.forEach(a => {
            lista.innerHTML += `
                <div class="rounded-2xl bg-blue-50 p-4">
                    <div class="font-extrabold text-blue-800">${a.paciente}</div>
                    <div class="text-sm text-slate-600">${a.procedimento}</div>
                    <div class="text-xs text-slate-500 mt-2">${new Date(a.inicio).toLocaleString("pt-BR")}</div>
                </div>`;
        });
    }

    function desenharCategorias(dados) {
        const ctx = document.getElementById("graficoCategorias");
        if (graficoCategorias) graficoCategorias.destroy();

        graficoCategorias = new Chart(ctx, {
            type: "bar",
            data: {
                labels: dados.map(x => x.categoria),
                datasets: [{ data: dados.map(x => x.total), backgroundColor: "#2563eb", borderRadius: 8 }]
            },
            options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } } }
        });
    }

    function desenharMovimentacoes(entradas, saidas) {
        const ctx = document.getElementById("graficoMovimentacoes");
        if (graficoMovimentacoes) graficoMovimentacoes.destroy();

        graficoMovimentacoes = new Chart(ctx, {
            type: "doughnut",
            data: {
                labels: ["Entradas", "Saídas"],
                datasets: [{ data: [entradas, saidas], backgroundColor: ["#059669", "#dc2626"] }]
            },
            options: { responsive: true, maintainAspectRatio: false }
        });
    }
</script>
}
