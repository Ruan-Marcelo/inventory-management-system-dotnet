@{
    ViewData["Title"] = "Login";
}

<div class="min-h-screen -mt-16 flex items-center justify-center bg-gradient-to-br from-sky-100 via-white to-sky-200 p-4">

    <div class="w-full max-w-md bg-white rounded-3xl shadow-2xl overflow-hidden">

        <!-- HEADER -->
        <div class="bg-gradient-to-r from-sky-500 to-cyan-500 p-8 text-center">

            <div class="w-20 h-20 mx-auto bg-white/20 rounded-3xl flex items-center justify-center mb-4">

                <img src="https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcRhOpQjMFFlUHZcV0ksxT0-e1J8OgLADX36Ew&s" />

            </div>
        </div>

        <!-- FORM -->
        <div class="p-8">

            <form id="loginForm" class="space-y-5">

                <!-- EMAIL -->
                <div>

                    <label for="email"
                           class="block text-sm font-semibold text-gray-700 mb-2">

                        Email

                    </label>

                    <div class="relative">

                        <i class="fa-solid fa-envelope absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>

                        <input type="email"
                               id="email"
                               required
                               placeholder="Digite seu email"
                               class="w-full h-14 pl-12 pr-4 rounded-2xl border border-gray-200 focus:border-sky-400 focus:ring-4 focus:ring-sky-100 outline-none transition">

                    </div>

                </div>

                <!-- SENHA -->
                <div>

                    <label for="password"
                           class="block text-sm font-semibold text-gray-700 mb-2">

                        Senha

                    </label>

                    <div class="relative">

                        <i class="fa-solid fa-lock absolute left-4 top-1/2 -translate-y-1/2 text-gray-400"></i>

                        <input type="password"
                               id="password"
                               required
                               placeholder="Digite sua senha"
                               class="w-full h-14 pl-12 pr-14 rounded-2xl border border-gray-200 focus:border-sky-400 focus:ring-4 focus:ring-sky-100 outline-none transition">

                        <button type="button"
                                id="togglePassword"
                                aria-label="Mostrar senha"
                                class="absolute right-3 top-1/2 -translate-y-1/2 w-10 h-10 rounded-xl hover:bg-gray-100 transition">

                            <i id="eyeIcon" class="fa-solid fa-eye text-gray-500"></i>

                        </button>

                    </div>

                </div>

                <!-- BOTÃO -->
                <button type="submit"
                        id="loginButton"
                        class="w-full h-14 rounded-2xl bg-gradient-to-r from-sky-500 to-cyan-500 text-white font-bold text-lg hover:scale-[1.01] active:scale-[0.99] transition-all shadow-lg">

                    Entrar

                </button>

            </form>

            <!-- STATUS -->
            <div id="statusMessage"
                 class="mt-5 text-center"
                 aria-live="polite">
            </div>

        </div>

    </div>

</div>

<script>

    const loginForm = document.getElementById('loginForm');

    const statusMessage = document.getElementById('statusMessage');

    const loginButton = document.getElementById('loginButton');

    const togglePassword = document.getElementById('togglePassword');

    const passwordInput = document.getElementById('password');

    const eyeIcon = document.getElementById('eyeIcon');

    // MOSTRAR SENHA
    togglePassword.addEventListener('click', () => {

        const isPassword = passwordInput.type === 'password';

        passwordInput.type = isPassword ? 'text' : 'password';

        eyeIcon.classList.toggle('fa-eye');

        eyeIcon.classList.toggle('fa-eye-slash');

    });

    // LOGIN
    loginForm.addEventListener('submit', async (e) => {

        e.preventDefault();

        const email = document.getElementById('email').value;

        const password = passwordInput.value;

        loginButton.disabled = true;

        loginButton.innerHTML = `
            <div class="flex items-center justify-center gap-3">

                <div class="w-5 h-5 border-2 border-white border-t-transparent rounded-full animate-spin"></div>

                Entrando...

            </div>
        `;

        try {

            const response = await fetch(
                'https://localhost:7004/api/UserAuth/Login',
                {
                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify({
                        email,
                        password
                    })
                }
            );

            if (response.ok) {

                const data = await response.json();

                localStorage.setItem('token', data.token);
                localStorage.setItem('usuario', JSON.stringify(data.usuario));

                statusMessage.innerHTML = `
                    <div class="bg-green-100 text-green-700 p-3 rounded-2xl">
                        Login realizado com sucesso!
                    </div>
                `;

                setTimeout(() => {

                    window.location.href = '/Home/Index';

                }, 1000);

            }
            else {
                let mensagem = 'Email ou senha inválidos.';

                try {
                    const erro = await response.json();
                    mensagem = erro.message || erro.mensagem || mensagem;
                } catch {
                }

                statusMessage.innerHTML = `
                    <div class="bg-red-100 text-red-700 p-3 rounded-2xl">
                        ${mensagem}
                    </div>
                `;

            }

        }
        catch {

            statusMessage.innerHTML = `
                <div class="bg-red-100 text-red-700 p-3 rounded-2xl">
                    Erro ao conectar com o servidor.
                </div>
            `;

        }

        loginButton.disabled = false;

        loginButton.innerHTML = `Entrar`;

    });

</script>
