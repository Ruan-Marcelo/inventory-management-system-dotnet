@{
    ViewData["Title"] = "Centro Cirúrgico";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="space-y-6">
    <section class="app-card p-5">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
            <div>
                <h2 class="text-lg font-extrabold text-slate-900">Agenda da sala cirúrgica</h2>
                <p class="text-sm text-slate-500">Controle de uso da sala para evitar conflito de horários.</p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
                <input id="filtroData" type="date" class="field" onchange="carregarAgendamentos()" />
                <button onclick="abrirModal()" class="btn-primary"><i class="fa fa-plus mr-2"></i>Novo agendamento</button>
            </div>
        </div>
    </section>

    <section id="listaAgendamentos" class="grid grid-cols-1 xl:grid-cols-2 gap-4"></section>
</div>

<div id="modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-950/60 p-4">
    <div class="app-card w-full max-w-2xl p-6">
        <div class="flex justify-between items-start gap-4 mb-5">
            <div>
                <h2 id="tituloModal" class="text-xl font-extrabold text-slate-900">Novo agendamento</h2>
                <p class="text-sm text-slate-500">Informe paciente, procedimento e horário.</p>
            </div>
            <button onclick="fecharModal()" class="w-10 h-10 rounded-xl bg-slate-100"><i class="fa fa-xmark"></i></button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <input id="paciente" class="field" placeholder="Paciente / animal" />
            <input id="veterinarioResponsavel" class="field" placeholder="Veterinário responsável" />
            <input id="procedimento" class="field sm:col-span-2" placeholder="Procedimento" />
            <input id="inicio" type="datetime-local" class="field" />
            <input id="fim" type="datetime-local" class="field" />
            <select id="status" class="field">
                <option value="Agendado">Agendado</option>
                <option value="Realizado">Realizado</option>
                <option value="Cancelado">Cancelado</option>
            </select>
            <input id="observacao" class="field" placeholder="Observação" />
        </div>

        <div class="flex justify-end gap-3 mt-6">
            <button onclick="fecharModal()" class="btn-soft">Cancelar</button>
            <button onclick="salvarAgendamento()" class="btn-primary">Salvar</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let agendamentos = [];
    let editandoId = null;

    document.getElementById("filtroData").valueAsDate = new Date();
    carregarAgendamentos();

    async function carregarAgendamentos() {
        const data = document.getElementById("filtroData").value;
        let url = `${API}/centrocirurgico`;
        if (data) {
            url += `?inicio=${data}T00:00:00&fim=${data}T23:59:59`;
        }

        const response = await apiFetch(url);
        agendamentos = response.ok ? await response.json() : [];
        renderizar();
    }

    function renderizar() {
        const lista = document.getElementById("listaAgendamentos");
        lista.innerHTML = "";

        if (agendamentos.length === 0) {
            lista.innerHTML = `<div class="app-card p-8 text-center text-slate-500 xl:col-span-2">Nenhum agendamento encontrado para o período.</div>`;
            return;
        }

        agendamentos.forEach(a => {
            const status = statusInfo(a.status);
            lista.innerHTML += `
                <article class="app-card p-5">
                    <div class="flex items-start justify-between gap-4">
                        <div>
                            <div class="text-xs font-bold text-slate-500">${formatarData(a.inicio)} até ${formatarHora(a.fim)}</div>
                            <h3 class="text-lg font-extrabold text-slate-900 mt-1">${a.paciente}</h3>
                            <p class="text-sm text-slate-600">${a.procedimento}</p>
                        </div>
                        <span class="px-3 py-1 rounded-full text-xs font-bold ${status.classe}">${a.status}</span>
                    </div>
                    <div class="mt-4 grid grid-cols-1 sm:grid-cols-2 gap-3 text-sm">
                        <div class="rounded-xl bg-slate-50 p-3">
                            <div class="text-slate-500">Veterinário</div>
                            <div class="font-bold">${a.veterinarioResponsavel}</div>
                        </div>
                        <div class="rounded-xl bg-slate-50 p-3">
                            <div class="text-slate-500">Observação</div>
                            <div class="font-bold">${a.observacao || "Sem observação"}</div>
                        </div>
                    </div>
                    <div class="flex gap-2 flex-wrap mt-4">
                        <button onclick='editar(${JSON.stringify(a)})' class="rounded-lg bg-amber-500 text-white px-3 py-2 font-bold">Editar</button>
                        <button onclick="remover(${a.id})" class="rounded-lg bg-slate-800 text-white px-3 py-2 font-bold">Remover</button>
                    </div>
                </article>`;
        });
    }

    function statusInfo(status) {
        if (status === "Realizado") return { classe: "bg-emerald-100 text-emerald-700" };
        if (status === "Cancelado") return { classe: "bg-red-100 text-red-700" };
        return { classe: "bg-blue-100 text-blue-700" };
    }

    async function salvarAgendamento() {
        const payload = {
            paciente: document.getElementById("paciente").value,
            veterinarioResponsavel: document.getElementById("veterinarioResponsavel").value,
            procedimento: document.getElementById("procedimento").value,
            inicio: document.getElementById("inicio").value,
            fim: document.getElementById("fim").value,
            status: document.getElementById("status").value,
            observacao: document.getElementById("observacao").value
        };

        const response = editandoId
            ? await apiFetch(`${API}/centrocirurgico/${editandoId}`, { method: "PUT", body: JSON.stringify({ id: editandoId, ...payload }) })
            : await apiFetch(`${API}/centrocirurgico`, { method: "POST", body: JSON.stringify(payload) });

        if (!response.ok) {
            toast(await response.text(), "error");
            return;
        }

        fecharModal();
        toast("Agendamento salvo.");
        carregarAgendamentos();
    }

    function editar(a) {
        editandoId = a.id;
        document.getElementById("tituloModal").innerText = "Editar agendamento";
        document.getElementById("paciente").value = a.paciente || "";
        document.getElementById("veterinarioResponsavel").value = a.veterinarioResponsavel || "";
        document.getElementById("procedimento").value = a.procedimento || "";
        document.getElementById("inicio").value = toInputDate(a.inicio);
        document.getElementById("fim").value = toInputDate(a.fim);
        document.getElementById("status").value = a.status || "Agendado";
        document.getElementById("observacao").value = a.observacao || "";
        abrirModal(false);
    }

    async function remover(id) {
        if (!confirm("Deseja remover este agendamento?")) return;
        const response = await apiFetch(`${API}/centrocirurgico/${id}`, { method: "DELETE" });
        if (!response.ok) {
            toast(await response.text(), "error");
            return;
        }
        toast("Agendamento removido.");
        carregarAgendamentos();
    }

    function abrirModal(limpar = true) {
        if (limpar) {
            editandoId = null;
            document.getElementById("tituloModal").innerText = "Novo agendamento";
            ["paciente", "veterinarioResponsavel", "procedimento", "inicio", "fim", "observacao"].forEach(id => document.getElementById(id).value = "");
            document.getElementById("status").value = "Agendado";
        }
        document.getElementById("modal").classList.remove("hidden");
        document.getElementById("modal").classList.add("flex");
    }

    function fecharModal() {
        document.getElementById("modal").classList.add("hidden");
        document.getElementById("modal").classList.remove("flex");
    }

    function formatarData(data) {
        return new Date(data).toLocaleString("pt-BR", { day: "2-digit", month: "2-digit", hour: "2-digit", minute: "2-digit" });
    }

    function formatarHora(data) {
        return new Date(data).toLocaleTimeString("pt-BR", { hour: "2-digit", minute: "2-digit" });
    }

    function toInputDate(data) {
        const d = new Date(data);
        d.setMinutes(d.getMinutes() - d.getTimezoneOffset());
        return d.toISOString().slice(0, 16);
    }
</script>
}
