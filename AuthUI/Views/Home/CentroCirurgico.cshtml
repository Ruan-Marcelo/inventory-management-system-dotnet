@{
    ViewData["Title"] = "Estoque cirúrgico";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="space-y-6">
    <section class="app-card p-5">
        <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-4">
            <div>
                <h2 class="text-lg font-extrabold text-slate-900">Materiais cirúrgicos</h2>
                <p class="text-sm text-slate-500">Controle separado dos itens usados em procedimentos e sala cirúrgica.</p>
            </div>
            <button onclick="abrirModal()" class="btn-primary">
                <i class="fa fa-plus mr-2"></i>Novo item cirúrgico
            </button>
        </div>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Itens cirúrgicos</p>
            <div id="totalItens" class="text-3xl font-extrabold text-slate-900 mt-1">0</div>
        </div>
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Abaixo do mínimo</p>
            <div id="baixoMinimo" class="text-3xl font-extrabold text-amber-600 mt-1">0</div>
        </div>
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Esgotados</p>
            <div id="esgotados" class="text-3xl font-extrabold text-red-600 mt-1">0</div>
        </div>
    </section>

    <section id="listaItens" class="grid grid-cols-1 lg:grid-cols-2 xl:grid-cols-3 gap-4"></section>
</div>

<div id="modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-950/60 p-4">
    <div class="app-card w-full max-w-2xl p-6">
        <div class="flex justify-between items-start gap-4 mb-5">
            <div>
                <h2 id="tituloModal" class="text-xl font-extrabold text-slate-900">Novo item cirúrgico</h2>
                <p class="text-sm text-slate-500">O item será salvo na categoria de materiais cirúrgicos.</p>
            </div>
            <button onclick="fecharModal()" class="w-10 h-10 rounded-xl bg-slate-100"><i class="fa fa-xmark"></i></button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <input id="nome" class="field" placeholder="Nome do material" />
            <input id="codigoInterno" class="field" placeholder="Código interno" />
            <input id="unidadeMedida" class="field" placeholder="Unidade: un, cx, pct..." value="un" />
            <input id="preco" type="number" min="0" step="0.01" class="field" placeholder="Preço unitário" />
            <input id="quantidade" type="number" min="0" class="field" placeholder="Quantidade atual" />
            <input id="estoqueMinimo" type="number" min="0" class="field" placeholder="Estoque mínimo" />
            <input id="descricao" class="field sm:col-span-2" placeholder="Descrição/observação" />
        </div>

        <div class="flex justify-end gap-3 mt-6">
            <button onclick="fecharModal()" class="btn-soft">Cancelar</button>
            <button onclick="salvarItem()" class="btn-primary">Salvar item</button>
        </div>
    </div>
</div>

<div id="modalMovimentacao" class="fixed inset-0 z-[75] hidden items-center justify-center bg-slate-950/60 p-4">
    <div class="app-card w-full max-w-md p-6">
        <div class="flex justify-between items-start gap-4 mb-5">
            <div>
                <h2 id="movTitulo" class="text-xl font-extrabold text-slate-900">Movimentar item</h2>
                <p id="movProduto" class="text-sm text-slate-500"></p>
            </div>
            <button onclick="fecharMovimentacao()" class="w-10 h-10 rounded-xl bg-slate-100"><i class="fa fa-xmark"></i></button>
        </div>

        <input id="movQuantidade" type="number" min="1" class="field mb-3" placeholder="Quantidade" />
        <textarea id="movObservacao" class="field min-h-24" placeholder="Observação opcional"></textarea>
        <div id="movErro" class="hidden mt-3 rounded-xl bg-red-50 p-3 text-sm text-red-700"></div>

        <div class="flex justify-end gap-3 mt-6">
            <button onclick="fecharMovimentacao()" class="btn-soft">Cancelar</button>
            <button onclick="salvarMovimentacao()" class="btn-primary">Confirmar</button>
        </div>
    </div>
</div>

<div id="modalConfirmacao" class="fixed inset-0 z-[76] hidden items-center justify-center bg-slate-950/60 p-4">
    <div class="app-card w-full max-w-md p-6">
        <h2 class="text-xl font-extrabold text-slate-900">Inativar item</h2>
        <p id="confirmacaoTexto" class="text-sm text-slate-600 mt-2"></p>
        <div class="flex justify-end gap-3 mt-6">
            <button onclick="fecharConfirmacao()" class="btn-soft">Cancelar</button>
            <button onclick="confirmarInativacao()" class="rounded-xl bg-red-600 hover:bg-red-700 text-white px-4 py-3 font-bold">Inativar</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let categoriaCirurgica = null;
    let itens = [];
    let editandoId = null;
    let movimentacaoAtual = null;
    let itemParaInativar = null;

    carregarTela();

    async function carregarTela() {
        await carregarCategoriaCirurgica();
        await carregarItens();
    }

    async function carregarCategoriaCirurgica() {
        const response = await apiFetch(`${API}/categorias`);
        if (!response.ok) {
            toast(await readError(response), "error");
            return;
        }

        const categorias = await response.json();
        categoriaCirurgica = categorias.find(c => normalizar(c.nome).includes("cirurg"));

        if (!categoriaCirurgica) {
            toast("Categoria de materiais cirúrgicos não encontrada. Cadastre em Categorias.", "error");
        }
    }

    async function carregarItens() {
        const response = await apiFetch(`${API}/produtos`);
        if (!response.ok) {
            toast(await readError(response), "error");
            return;
        }

        const produtos = await response.json();
        itens = produtos.filter(p => normalizar(p.categoria?.nome || "").includes("cirurg"));
        renderizar();
    }

    function renderizar() {
        document.getElementById("totalItens").innerText = itens.length;
        document.getElementById("baixoMinimo").innerText = itens.filter(i => i.quantidade > 0 && i.quantidade <= i.estoqueMinimo).length;
        document.getElementById("esgotados").innerText = itens.filter(i => i.quantidade <= 0).length;

        const lista = document.getElementById("listaItens");
        lista.innerHTML = "";

        if (itens.length === 0) {
            lista.innerHTML = `<div class="app-card p-8 text-center text-slate-500 lg:col-span-2 xl:col-span-3">Nenhum material cirúrgico cadastrado.</div>`;
            return;
        }

        itens.forEach(item => {
            const status = statusItem(item);
            const itemJson = JSON.stringify(item).replaceAll("'", "&#39;");

            lista.innerHTML += `
                <article class="app-card p-5">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="text-lg font-extrabold text-slate-900">${item.nome}</h3>
                            <p class="text-xs text-slate-500">${item.codigoInterno || "Sem código"} - ${item.descricao || "Sem descrição"}</p>
                        </div>
                        <span class="px-2 py-1 rounded-full text-xs font-bold ${status.classe}">${status.texto}</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mt-4 text-sm">
                        <div class="rounded-xl bg-slate-50 p-3">
                            <div class="text-slate-500">Quantidade</div>
                            <div class="font-extrabold">${item.quantidade} ${item.unidadeMedida || "un"}</div>
                        </div>
                        <div class="rounded-xl bg-slate-50 p-3">
                            <div class="text-slate-500">Mínimo</div>
                            <div class="font-extrabold">${item.estoqueMinimo}</div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 mt-4">
                        <button onclick="abrirMovimentacao(${item.id}, 'ENTRADA')" class="rounded-lg bg-emerald-600 text-white px-3 py-2 font-bold text-sm">Entrada</button>
                        <button onclick="abrirMovimentacao(${item.id}, 'SAIDA')" class="rounded-lg bg-red-600 text-white px-3 py-2 font-bold text-sm">Saída</button>
                        <button onclick='editarItem(${itemJson})' class="rounded-lg bg-amber-500 text-white px-3 py-2 font-bold text-sm">Editar</button>
                        <button onclick='abrirConfirmacao(${itemJson})' class="rounded-lg bg-slate-800 text-white px-3 py-2 font-bold text-sm">Inativar</button>
                    </div>
                </article>`;
        });
    }

    function statusItem(item) {
        if (item.quantidade <= 0) return { texto: "Esgotado", classe: "bg-red-100 text-red-700" };
        if (item.quantidade <= item.estoqueMinimo) return { texto: "Baixo", classe: "bg-amber-100 text-amber-700" };
        return { texto: "OK", classe: "bg-emerald-100 text-emerald-700" };
    }

    async function salvarItem() {
        if (!categoriaCirurgica) {
            toast("Categoria cirúrgica não encontrada.", "error");
            return;
        }

        const item = {
            nome: document.getElementById("nome").value,
            descricao: document.getElementById("descricao").value,
            codigoInterno: document.getElementById("codigoInterno").value,
            categoriaId: categoriaCirurgica.id,
            unidadeMedida: document.getElementById("unidadeMedida").value || "un",
            preco: parseFloat(document.getElementById("preco").value || "0"),
            quantidade: parseInt(document.getElementById("quantidade").value || "0"),
            estoqueMinimo: parseInt(document.getElementById("estoqueMinimo").value || "0")
        };

        const response = editandoId
            ? await apiFetch(`${API}/produtos/${editandoId}`, { method: "PUT", body: JSON.stringify({ id: editandoId, ...item }) })
            : await apiFetch(`${API}/produtos`, { method: "POST", body: JSON.stringify(item) });

        if (!response.ok) {
            toast(await readError(response), "error");
            return;
        }

        fecharModal();
        toast("Item cirúrgico salvo.");
        carregarItens();
    }

    function editarItem(item) {
        editandoId = item.id;
        document.getElementById("tituloModal").innerText = "Editar item cirúrgico";
        document.getElementById("nome").value = item.nome || "";
        document.getElementById("descricao").value = item.descricao || "";
        document.getElementById("codigoInterno").value = item.codigoInterno || "";
        document.getElementById("unidadeMedida").value = item.unidadeMedida || "un";
        document.getElementById("preco").value = item.preco || 0;
        document.getElementById("quantidade").value = item.quantidade || 0;
        document.getElementById("estoqueMinimo").value = item.estoqueMinimo || 0;
        abrirModal(false);
    }

    function abrirConfirmacao(item) {
        itemParaInativar = item;
        document.getElementById("confirmacaoTexto").innerText = `Deseja inativar "${item.nome}"? Ele sairá da listagem principal.`;
        document.getElementById("modalConfirmacao").classList.remove("hidden");
        document.getElementById("modalConfirmacao").classList.add("flex");
    }

    function fecharConfirmacao() {
        document.getElementById("modalConfirmacao").classList.add("hidden");
        document.getElementById("modalConfirmacao").classList.remove("flex");
    }

    async function confirmarInativacao() {
        if (!itemParaInativar) return;
        const response = await apiFetch(`${API}/produtos/${itemParaInativar.id}`, { method: "DELETE" });
        if (!response.ok) {
            toast(await readError(response), "error");
            return;
        }
        fecharConfirmacao();
        toast("Item inativado.");
        carregarItens();
    }

    function abrirMovimentacao(produtoId, tipo) {
        const item = itens.find(p => p.id === produtoId);
        movimentacaoAtual = { produtoId, tipo };
        document.getElementById("movTitulo").innerText = tipo === "ENTRADA" ? "Registrar entrada" : "Registrar saída";
        document.getElementById("movProduto").innerText = item ? `${item.nome} - estoque atual: ${item.quantidade} ${item.unidadeMedida || "un"}` : "";
        document.getElementById("movQuantidade").value = "";
        document.getElementById("movObservacao").value = "";
        document.getElementById("movErro").classList.add("hidden");
        document.getElementById("modalMovimentacao").classList.remove("hidden");
        document.getElementById("modalMovimentacao").classList.add("flex");
    }

    function fecharMovimentacao() {
        document.getElementById("modalMovimentacao").classList.add("hidden");
        document.getElementById("modalMovimentacao").classList.remove("flex");
    }

    async function salvarMovimentacao() {
        const quantidade = parseInt(document.getElementById("movQuantidade").value || "0");
        const erro = document.getElementById("movErro");

        if (!movimentacaoAtual || quantidade <= 0) {
            erro.innerText = "Informe uma quantidade maior que zero.";
            erro.classList.remove("hidden");
            return;
        }

        const response = await apiFetch(`${API}/movimentacoes`, {
            method: "POST",
            body: JSON.stringify({
                produtoId: movimentacaoAtual.produtoId,
                tipo: movimentacaoAtual.tipo,
                quantidade,
                observacao: document.getElementById("movObservacao").value
            })
        });

        if (!response.ok) {
            erro.innerHTML = await readError(response);
            erro.classList.remove("hidden");
            return;
        }

        fecharMovimentacao();
        toast("Movimentação registrada.");
        carregarItens();
    }

    function abrirModal(limpar = true) {
        if (limpar) limparFormulario();
        document.getElementById("modal").classList.remove("hidden");
        document.getElementById("modal").classList.add("flex");
    }

    function fecharModal() {
        document.getElementById("modal").classList.add("hidden");
        document.getElementById("modal").classList.remove("flex");
    }

    function limparFormulario() {
        editandoId = null;
        document.getElementById("tituloModal").innerText = "Novo item cirúrgico";
        ["nome", "descricao", "codigoInterno", "preco", "quantidade", "estoqueMinimo"].forEach(id => document.getElementById(id).value = "");
        document.getElementById("unidadeMedida").value = "un";
    }

    function normalizar(valor) {
        return valor.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();
    }
</script>
}
