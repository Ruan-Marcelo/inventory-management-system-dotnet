@{
    ViewData["Title"] = "Estoque";
    Layout = "~/Views/Shared/_DashboardLayout.cshtml";
}

<div class="space-y-6">
    <section class="app-card p-4 sm:p-5">
        <div class="flex flex-col xl:flex-row xl:items-end xl:justify-between gap-4">
            <div>
                <h2 class="text-lg font-extrabold text-slate-900">Produtos e insumos</h2>
                <p id="descricaoEscopo" class="text-sm text-slate-500"></p>
            </div>
            <div class="flex flex-col sm:flex-row gap-3">
                <input id="filtroProduto" class="field sm:w-72" placeholder="Buscar por nome, codigo ou categoria" oninput="filtrarProdutos()" />
                <select id="filtroEstoque" class="field sm:w-48" onchange="filtrarProdutos()">
                    <option value="">Todos os status</option>
                    <option value="baixo">Estoque baixo</option>
                    <option value="zerado">Esgotado</option>
                    <option value="ok">Estoque OK</option>
                </select>
                <button onclick="abrirModal()" class="btn-primary">
                    <i class="fa fa-plus mr-2"></i>Novo produto
                </button>
            </div>
        </div>
    </section>

    <section class="grid grid-cols-1 sm:grid-cols-3 gap-4">
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Produtos ativos</p>
            <div id="cardTotal" class="text-3xl font-extrabold text-slate-900 mt-1">0</div>
        </div>
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Abaixo do minimo</p>
            <div id="cardBaixo" class="text-3xl font-extrabold text-amber-600 mt-1">0</div>
        </div>
        <div class="app-card p-5">
            <p class="text-sm text-slate-500">Esgotados</p>
            <div id="cardZerado" class="text-3xl font-extrabold text-red-600 mt-1">0</div>
        </div>
    </section>

    <section id="cardsProdutos" class="grid grid-cols-1 gap-4 md:hidden"></section>

    <section class="app-card table-wrap hidden md:block">
        <table class="w-full text-sm">
            <thead class="bg-slate-50 text-slate-600">
                <tr>
                    <th class="p-4 text-left">Produto</th>
                    <th class="p-4 text-left">Categoria</th>
                    <th class="p-4 text-left">Estoque</th>
                    <th class="p-4 text-left">Preco</th>
                    <th class="p-4 text-left">Acoes</th>
                </tr>
            </thead>
            <tbody id="tabelaProdutos"></tbody>
        </table>
    </section>
</div>

<div id="modal" class="fixed inset-0 z-[70] hidden items-center justify-center bg-slate-950/60 p-4">
    <div class="app-card w-full max-w-2xl p-5 sm:p-6">
        <div class="flex items-center justify-between gap-4 mb-5">
            <div>
                <h2 id="tituloModal" class="text-xl font-extrabold text-slate-900">Novo produto</h2>
                <p class="text-sm text-slate-500">Preencha os dados de controle do estoque.</p>
            </div>
            <button onclick="fecharModal()" class="w-10 h-10 rounded-xl bg-slate-100">
                <i class="fa fa-xmark"></i>
            </button>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <input id="nome" class="field" placeholder="Nome do produto" />
            <input id="codigoInterno" class="field" placeholder="Codigo interno" />
            <select id="categoriaId" class="field"></select>
            <input id="unidadeMedida" class="field" placeholder="Unidade: un, cx, ml..." value="un" />
            <input id="preco" type="number" min="0" step="0.01" class="field" placeholder="Preco unitario" />
            <input id="quantidade" type="number" min="0" class="field" placeholder="Quantidade atual" />
            <input id="estoqueMinimo" type="number" min="0" class="field" placeholder="Estoque minimo" />
            <input id="descricao" class="field" placeholder="Descricao/observacao" />
        </div>

        <div class="flex flex-col sm:flex-row justify-end gap-3 mt-6">
            <button onclick="fecharModal()" class="btn-soft">Cancelar</button>
            <button onclick="salvarProduto()" class="btn-primary">Salvar produto</button>
        </div>
    </div>
</div>

<div id="modalMovimentacao" class="fixed inset-0 z-[75] hidden items-center justify-center bg-slate-950/60 p-4">
    <div class="app-card w-full max-w-md p-5 sm:p-6">
        <div class="flex items-start justify-between gap-4 mb-5">
            <div>
                <h2 id="movTitulo" class="text-xl font-extrabold text-slate-900">Movimentar estoque</h2>
                <p id="movProduto" class="text-sm text-slate-500"></p>
            </div>
            <button onclick="fecharMovimentacao()" class="w-10 h-10 rounded-xl bg-slate-100">
                <i class="fa fa-xmark"></i>
            </button>
        </div>

        <input id="movQuantidade" type="number" min="1" class="field mb-3" placeholder="Quantidade" />
        <textarea id="movObservacao" class="field min-h-24" placeholder="Observacao opcional"></textarea>
        <div id="movErro" class="hidden mt-3 rounded-xl bg-red-50 p-3 text-sm text-red-700"></div>

        <div class="flex flex-col sm:flex-row justify-end gap-3 mt-6">
            <button onclick="fecharMovimentacao()" class="btn-soft">Cancelar</button>
            <button onclick="salvarMovimentacao()" class="btn-primary">Confirmar</button>
        </div>
    </div>
</div>

<div id="modalConfirmacao" class="fixed inset-0 z-[76] hidden items-center justify-center bg-slate-950/60 p-4">
    <div class="app-card w-full max-w-md p-5 sm:p-6">
        <h2 class="text-xl font-extrabold text-slate-900">Inativar produto</h2>
        <p id="confirmacaoTexto" class="text-sm text-slate-600 mt-2"></p>
        <div class="flex flex-col sm:flex-row justify-end gap-3 mt-6">
            <button onclick="fecharConfirmacao()" class="btn-soft">Cancelar</button>
            <button onclick="confirmarInativacao()" class="rounded-xl bg-red-600 hover:bg-red-700 text-white px-4 py-3 font-bold">Inativar</button>
        </div>
    </div>
</div>

@section Scripts {
<script>
    let editandoId = null;
    let todosProdutos = [];
    let categorias = [];
    let movimentacaoAtual = null;
    let produtoParaInativar = null;

    document.getElementById("descricaoEscopo").innerText =
        usuario?.perfil === "VeterinarioParceiro"
            ? "Este e o seu estoque pessoal. A ONG e outros veterinarios nao tem acesso a estes produtos."
            : "Este e o estoque institucional da AVA. Veterinarios parceiros possuem estoques pessoais separados.";

    carregarTudo();

    async function carregarTudo() {
        await carregarCategorias();
        await carregarProdutos();
    }

    async function carregarCategorias() {
        const response = await apiFetch(`${API}/categorias`);
        if (!response.ok) {
            toast(await readError(response), "error");
            return;
        }

        categorias = await response.json();
        const select = document.getElementById("categoriaId");
        select.innerHTML = `<option value="">Sem categoria</option>`;
        categorias.forEach(c => select.innerHTML += `<option value="${c.id}">${c.nome}</option>`);
    }

    async function carregarProdutos() {
        const response = await apiFetch(`${API}/produtos`);
        if (!response.ok) {
            toast(await readError(response), "error");
            return;
        }

        todosProdutos = await response.json();
        atualizarCards();
        renderizarProdutos(todosProdutos);
    }

    function atualizarCards() {
        document.getElementById("cardTotal").innerText = todosProdutos.length;
        document.getElementById("cardBaixo").innerText = todosProdutos.filter(p => p.quantidade > 0 && p.quantidade <= p.estoqueMinimo).length;
        document.getElementById("cardZerado").innerText = todosProdutos.filter(p => p.quantidade <= 0).length;
    }

    function statusProduto(produto) {
        if (produto.quantidade <= 0) return { texto: "Esgotado", classe: "bg-red-100 text-red-700" };
        if (produto.quantidade <= produto.estoqueMinimo) return { texto: "Baixo", classe: "bg-amber-100 text-amber-700" };
        return { texto: "OK", classe: "bg-emerald-100 text-emerald-700" };
    }

    function renderizarProdutos(produtos) {
        const tabela = document.getElementById("tabelaProdutos");
        const cards = document.getElementById("cardsProdutos");
        tabela.innerHTML = "";
        cards.innerHTML = "";

        if (produtos.length === 0) {
            tabela.innerHTML = `<tr><td colspan="5" class="p-6 text-center text-slate-500">Nenhum produto encontrado.</td></tr>`;
            cards.innerHTML = `<div class="app-card p-6 text-center text-slate-500">Nenhum produto encontrado.</div>`;
            return;
        }

        produtos.forEach(produto => {
            const status = statusProduto(produto);
            const produtoJson = JSON.stringify(produto).replaceAll("'", "&#39;");

            tabela.innerHTML += `
                <tr class="border-t border-slate-100 hover:bg-slate-50">
                    <td class="p-4">
                        <div class="font-extrabold text-slate-900">${produto.nome}</div>
                        <div class="text-xs text-slate-500">${produto.codigoInterno || "Sem codigo"} - ${produto.descricao || "Sem descricao"}</div>
                    </td>
                    <td class="p-4">${produto.categoria?.nome || "Sem categoria"}</td>
                    <td class="p-4">
                        <div class="flex items-center gap-2 flex-wrap">
                            <span class="font-extrabold">${produto.quantidade} ${produto.unidadeMedida || "un"}</span>
                            <span class="px-2 py-1 rounded-full text-xs font-bold ${status.classe}">${status.texto}</span>
                        </div>
                        <div class="text-xs text-slate-500 mt-1">Minimo: ${produto.estoqueMinimo}</div>
                    </td>
                    <td class="p-4">R$ ${Number(produto.preco).toFixed(2)}</td>
                    <td class="p-4">
                        <div class="grid grid-cols-2 xl:grid-cols-4 gap-2 min-w-[260px]">
                            ${botoesProduto(produto, produtoJson)}
                        </div>
                    </td>
                </tr>`;

            cards.innerHTML += `
                <article class="app-card p-4">
                    <div class="flex items-start justify-between gap-3">
                        <div>
                            <h3 class="font-extrabold text-slate-900">${produto.nome}</h3>
                            <p class="text-xs text-slate-500">${produto.categoria?.nome || "Sem categoria"}</p>
                        </div>
                        <span class="px-2 py-1 rounded-full text-xs font-bold ${status.classe}">${status.texto}</span>
                    </div>
                    <div class="grid grid-cols-2 gap-3 mt-4 text-sm">
                        <div class="rounded-xl bg-slate-50 p-3">
                            <div class="text-slate-500">Quantidade</div>
                            <div class="font-extrabold">${produto.quantidade} ${produto.unidadeMedida || "un"}</div>
                        </div>
                        <div class="rounded-xl bg-slate-50 p-3">
                            <div class="text-slate-500">Minimo</div>
                            <div class="font-extrabold">${produto.estoqueMinimo}</div>
                        </div>
                    </div>
                    <div class="grid grid-cols-2 gap-2 mt-4">
                        ${botoesProduto(produto, produtoJson)}
                    </div>
                </article>`;
        });
    }

    function botoesProduto(produto, produtoJson) {
        return `
            <button onclick="abrirMovimentacao(${produto.id}, 'ENTRADA')" class="rounded-lg bg-emerald-600 text-white px-3 py-2 font-bold text-sm">Entrada</button>
            <button onclick="abrirMovimentacao(${produto.id}, 'SAIDA')" class="rounded-lg bg-red-600 text-white px-3 py-2 font-bold text-sm">Saida</button>
            <button onclick='editarProduto(${produtoJson})' class="rounded-lg bg-amber-500 text-white px-3 py-2 font-bold text-sm">Editar</button>
            <button onclick='abrirConfirmacao(${produtoJson})' class="rounded-lg bg-slate-800 text-white px-3 py-2 font-bold text-sm">Inativar</button>`;
    }

    function filtrarProdutos() {
        const texto = document.getElementById("filtroProduto").value.toLowerCase();
        const estoque = document.getElementById("filtroEstoque").value;

        let filtrados = todosProdutos.filter(p =>
            `${p.nome} ${p.codigoInterno || ""} ${p.categoria?.nome || ""}`.toLowerCase().includes(texto)
        );

        if (estoque === "baixo") filtrados = filtrados.filter(p => p.quantidade > 0 && p.quantidade <= p.estoqueMinimo);
        if (estoque === "zerado") filtrados = filtrados.filter(p => p.quantidade <= 0);
        if (estoque === "ok") filtrados = filtrados.filter(p => p.quantidade > p.estoqueMinimo);

        renderizarProdutos(filtrados);
    }

    async function salvarProduto() {
        const produto = {
            nome: document.getElementById("nome").value,
            descricao: document.getElementById("descricao").value,
            codigoInterno: document.getElementById("codigoInterno").value,
            categoriaId: document.getElementById("categoriaId").value || null,
            unidadeMedida: document.getElementById("unidadeMedida").value || "un",
            preco: parseFloat(document.getElementById("preco").value || "0"),
            quantidade: parseInt(document.getElementById("quantidade").value || "0"),
            estoqueMinimo: parseInt(document.getElementById("estoqueMinimo").value || "0")
        };

        const response = editandoId
            ? await apiFetch(`${API}/produtos/${editandoId}`, { method: "PUT", body: JSON.stringify({ id: editandoId, ...produto }) })
            : await apiFetch(`${API}/produtos`, { method: "POST", body: JSON.stringify(produto) });

        if (!response.ok) {
            toast(await readError(response), "error");
            return;
        }

        fecharModal();
        toast("Produto salvo com sucesso.");
        carregarProdutos();
    }

    function editarProduto(produto) {
        editandoId = produto.id;
        document.getElementById("tituloModal").innerText = "Editar produto";
        document.getElementById("nome").value = produto.nome || "";
        document.getElementById("descricao").value = produto.descricao || "";
        document.getElementById("codigoInterno").value = produto.codigoInterno || "";
        document.getElementById("categoriaId").value = produto.categoriaId || "";
        document.getElementById("unidadeMedida").value = produto.unidadeMedida || "un";
        document.getElementById("preco").value = produto.preco || 0;
        document.getElementById("quantidade").value = produto.quantidade || 0;
        document.getElementById("estoqueMinimo").value = produto.estoqueMinimo || 0;
        abrirModal(false);
    }

    function abrirMovimentacao(produtoId, tipo) {
        const produto = todosProdutos.find(p => p.id === produtoId);
        movimentacaoAtual = { produtoId, tipo };
        document.getElementById("movTitulo").innerText = tipo === "ENTRADA" ? "Registrar entrada" : "Registrar saida";
        document.getElementById("movProduto").innerText = produto ? `${produto.nome} - estoque atual: ${produto.quantidade} ${produto.unidadeMedida || "un"}` : "";
        document.getElementById("movQuantidade").value = "";
        document.getElementById("movObservacao").value = "";
        document.getElementById("movErro").classList.add("hidden");
        document.getElementById("modalMovimentacao").classList.remove("hidden");
        document.getElementById("modalMovimentacao").classList.add("flex");
    }

    function fecharMovimentacao() {
        document.getElementById("modalMovimentacao").classList.add("hidden");
        document.getElementById("modalMovimentacao").classList.remove("flex");
    }

    async function salvarMovimentacao() {
        const quantidade = parseInt(document.getElementById("movQuantidade").value || "0");
        const erro = document.getElementById("movErro");

        if (!movimentacaoAtual || quantidade <= 0) {
            erro.innerText = "Informe uma quantidade maior que zero.";
            erro.classList.remove("hidden");
            return;
        }

        const response = await apiFetch(`${API}/movimentacoes`, {
            method: "POST",
            body: JSON.stringify({
                produtoId: movimentacaoAtual.produtoId,
                tipo: movimentacaoAtual.tipo,
                quantidade,
                observacao: document.getElementById("movObservacao").value
            })
        });

        if (!response.ok) {
            erro.innerHTML = await readError(response);
            erro.classList.remove("hidden");
            return;
        }

        fecharMovimentacao();
        toast("Movimentacao registrada.");
        carregarProdutos();
    }

    function abrirConfirmacao(produto) {
        produtoParaInativar = produto;
        document.getElementById("confirmacaoTexto").innerText = `Deseja inativar "${produto.nome}"? Ele sairá da listagem principal.`;
        document.getElementById("modalConfirmacao").classList.remove("hidden");
        document.getElementById("modalConfirmacao").classList.add("flex");
    }

    function fecharConfirmacao() {
        document.getElementById("modalConfirmacao").classList.add("hidden");
        document.getElementById("modalConfirmacao").classList.remove("flex");
    }

    async function confirmarInativacao() {
        if (!produtoParaInativar) return;
        const response = await apiFetch(`${API}/produtos/${produtoParaInativar.id}`, { method: "DELETE" });
        if (!response.ok) {
            toast(await readError(response), "error");
            return;
        }

        fecharConfirmacao();
        toast("Produto inativado.");
        carregarProdutos();
    }

    function abrirModal(limpar = true) {
        if (limpar) limparFormulario();
        document.getElementById("modal").classList.remove("hidden");
        document.getElementById("modal").classList.add("flex");
    }

    function fecharModal() {
        document.getElementById("modal").classList.add("hidden");
        document.getElementById("modal").classList.remove("flex");
    }

    function limparFormulario() {
        editandoId = null;
        document.getElementById("tituloModal").innerText = "Novo produto";
        ["nome", "descricao", "codigoInterno", "preco", "quantidade", "estoqueMinimo"].forEach(id => document.getElementById(id).value = "");
        document.getElementById("unidadeMedida").value = "un";
        document.getElementById("categoriaId").value = "";
    }
</script>
}
