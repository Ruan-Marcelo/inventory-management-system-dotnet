<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - AVA Manager</title>

    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>
        body { font-family: 'Manrope', sans-serif; }
        .menu-item {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 11px 12px;
            border-radius: 12px;
            color: #dbeafe;
            transition: .18s ease;
        }
        .menu-item:hover, .menu-item.active {
            background: rgba(255,255,255,.13);
            color: #fff;
        }
        .app-card {
            background: #fff;
            border: 1px solid #e5edf7;
            border-radius: 18px;
            box-shadow: 0 18px 45px rgba(15, 23, 42, .06);
        }
        .field {
            width: 100%;
            border: 1px solid #dbe4ef;
            border-radius: 12px;
            padding: 10px 12px;
            outline: none;
            background: #fff;
        }
        .field:focus {
            border-color: #2563eb;
            box-shadow: 0 0 0 4px rgba(37, 99, 235, .12);
        }
        .btn-primary {
            background: #2563eb;
            color: white;
            border-radius: 12px;
            padding: 10px 14px;
            font-weight: 700;
        }
        .btn-primary:hover { background: #1d4ed8; }
        .btn-soft {
            background: #eff6ff;
            color: #1d4ed8;
            border-radius: 12px;
            padding: 10px 14px;
            font-weight: 700;
        }
        .table-wrap { overflow-x: auto; }
        th { white-space: nowrap; }
        td { vertical-align: top; }
    </style>
</head>

<body class="bg-slate-100 text-slate-800">
    <button id="overlay" onclick="toggleSidebarMobile()" aria-label="Fechar menu" class="hidden fixed inset-0 bg-slate-950/50 z-40 lg:hidden"></button>

    <aside id="sidebar" class="fixed inset-y-0 left-0 z-50 w-72 bg-slate-950 text-white shadow-2xl transition-transform duration-300 lg:translate-x-0 -translate-x-full">
        <div class="h-full flex flex-col">
            <div class="p-5 border-b border-white/10">
                <div class="flex items-center gap-3">
                    <div class="w-11 h-11 rounded-2xl bg-blue-500 flex items-center justify-center">
                        <i class="fa-solid fa-paw text-xl"></i>
                    </div>
                    <div>
                        <div class="font-extrabold text-lg leading-tight">AVA Manager</div>
                        <div class="text-xs text-blue-200">Gestão interna da ONG</div>
                    </div>
                </div>
            </div>

            <nav class="p-4 space-y-1 flex-1">
                <a href="/Home/Index" class="menu-item"><i class="fa fa-chart-line w-5"></i><span>Dashboard</span></a>
                <a href="/Home/Produtos" class="menu-item"><i class="fa fa-boxes-stacked w-5"></i><span>Estoque</span></a>
                <a href="/Home/Categorias" class="menu-item"><i class="fa fa-tags w-5"></i><span>Categorias</span></a>
                <a href="/Home/Movimentacoes" class="menu-item"><i class="fa fa-right-left w-5"></i><span>Movimentações</span></a>
                <a href="/Home/CentroCirurgico" class="menu-item"><i class="fa fa-briefcase-medical w-5"></i><span>Estoque cirúrgico</span></a>
                <a href="/Home/Relatorios" class="menu-item"><i class="fa fa-file-lines w-5"></i><span>Relatórios</span></a>
                <a href="/Home/Usuarios" data-admin-only="true" class="menu-item"><i class="fa fa-user-shield w-5"></i><span>Usuários</span></a>
            </nav>

            <div class="p-4 border-t border-white/10">
                <div class="rounded-2xl bg-white/8 p-3 mb-3">
                    <div id="usuarioNome" class="font-bold text-sm truncate">Usuário</div>
                    <div id="usuarioPerfil" class="text-xs text-blue-200">Perfil</div>
                </div>
                <button id="logoutBtn" class="w-full flex items-center justify-center gap-2 rounded-xl bg-red-500 hover:bg-red-600 px-4 py-3 font-bold">
                    <i class="fa fa-right-from-bracket"></i>
                    Sair
                </button>
            </div>
        </div>
    </aside>

    <div class="lg:pl-72 min-h-screen">
        <header class="sticky top-0 z-30 bg-white/85 backdrop-blur border-b border-slate-200">
            <div class="px-4 sm:px-6 py-4 flex items-center justify-between gap-4">
                <div class="flex items-center gap-3 min-w-0">
                    <button onclick="toggleSidebarMobile()" class="lg:hidden w-10 h-10 rounded-xl bg-slate-100 text-slate-700">
                        <i class="fa fa-bars"></i>
                    </button>
                    <div class="min-w-0">
                        <h1 class="text-xl sm:text-2xl font-extrabold text-slate-900 truncate">@ViewData["Title"]</h1>
                        <p class="text-sm text-slate-500 hidden sm:block">Controle operacional da clínica veterinária popular</p>
                    </div>
                </div>
                <div class="hidden md:flex items-center gap-2 rounded-full bg-blue-50 px-4 py-2 text-blue-700 font-bold text-sm">
                    <i class="fa fa-shield-heart"></i>
                    AVA
                </div>
            </div>
        </header>

        <main class="p-4 sm:p-6">
            @RenderBody()
        </main>
    </div>

    <div id="toast" class="fixed bottom-4 right-4 z-[80] hidden max-w-sm rounded-2xl px-4 py-3 shadow-2xl text-white"></div>

    <script>
        const API = "https://localhost:7004/api";
        const token = localStorage.getItem("token");
        const usuario = JSON.parse(localStorage.getItem("usuario") || "null");

        if (!token) {
            window.location.href = "/Home/Login";
        }

        if (usuario) {
            document.getElementById("usuarioNome").innerText = usuario.name || usuario.email || "Usuário";
            document.getElementById("usuarioPerfil").innerText = usuario.perfil || "Perfil";
        }

        if (usuario?.perfil !== "Admin") {
            document.querySelectorAll("[data-admin-only='true']").forEach(item => item.remove());
        }

        document.querySelectorAll(".menu-item").forEach(link => {
            const url = new URL(link.href);
            if (url.pathname === window.location.pathname) link.classList.add("active");
        });

        function toggleSidebarMobile() {
            document.getElementById("sidebar").classList.toggle("-translate-x-full");
            document.getElementById("overlay").classList.toggle("hidden");
        }

        function toast(message, type = "success") {
            const el = document.getElementById("toast");
            el.innerHTML = message;
            el.className = "fixed bottom-4 right-4 z-[80] max-w-sm rounded-2xl px-4 py-3 shadow-2xl text-white " + (type === "error" ? "bg-red-600" : "bg-slate-900");
            el.classList.remove("hidden");
            setTimeout(() => el.classList.add("hidden"), type === "error" ? 5200 : 3200);
        }

        async function readError(response) {
            const fallback = response.status >= 500
                ? "Erro interno no servidor. Verifique se a API está rodando corretamente."
                : "Não foi possível concluir a operação.";

            const text = await response.text();
            if (!text) return fallback;

            try {
                const json = JSON.parse(text);
                if (Array.isArray(json.erros)) return json.erros.join("<br>");
                if (json.mensagem) return json.mensagem;
                if (json.message) return json.message;
                if (json.title) return json.title;
            } catch {
            }

            return text.length > 350 ? fallback : text;
        }

        async function apiFetch(url, options = {}) {
            try {
                const response = await fetch(url, {
                    ...options,
                    headers: {
                        "Content-Type": "application/json",
                        "Authorization": "Bearer " + localStorage.getItem("token"),
                        ...options.headers
                    }
                });

                if (response.status === 401 || response.status === 403) {
                    localStorage.removeItem("token");
                    localStorage.removeItem("usuario");
                    window.location.href = "/Home/Login";
                }

                return response;
            } catch {
                toast("Não foi possível conectar com a API. Verifique se AuthAPI está rodando.", "error");
                return new Response("", { status: 0 });
            }
        }

        document.getElementById("logoutBtn").addEventListener("click", async () => {
            await fetch(`${API}/UserAuth/Logout`, { method: "POST" });
            localStorage.removeItem("token");
            localStorage.removeItem("usuario");
            window.location.href = "/Home/Login";
        });
    </script>

    @RenderSection("Scripts", required: false)
</body>
</html>
