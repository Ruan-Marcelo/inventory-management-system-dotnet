<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Dashboard</title>

    <script src="https://cdn.tailwindcss.com"></script>

    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;600;700&display=swap" rel="stylesheet" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">

    <style>

        body {
        font-family: 'Manrope', sans-serif;
        }

        .menu-item {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 12px;
        border-radius: 10px;
        transition: 0.2s;
        white-space: nowrap;
        }

        .menu-item:hover {
        background: rgba(255,255,255,0.1);
        }

        .active {
        background: rgba(255,255,255,0.15);
        }

        .menu-text {
        transition: opacity 0.2s;
        }

        .collapsed .menu-text {
        display: none;
        }

        .collapsed #logoText {
        display: none;
        }

        .collapsed .menu-item {
        justify-content: center;
        }

    </style>
</head>

<body class="bg-gray-100 overflow-x-hidden">

    <!-- OVERLAY MOBILE -->
    <div id="overlay"
         onclick="toggleSidebarMobile()"
         class="hidden fixed inset-0 bg-black bg-opacity-50 z-40 md:hidden">
    </div>

    <!-- SIDEBAR -->
    <aside id="sidebar"
           class="fixed top-0 left-0 z-50 h-screen w-64 bg-blue-900 text-white shadow-xl transition-all duration-300">

        <!-- HEADER -->
        <div class="p-5 border-b border-blue-800 flex items-center justify-between">

            <div class="flex items-center gap-3">

                <i class="fa-solid fa-paw text-2xl"></i>

                <span id="logoText"
                      class="text-xl font-bold">
                    AVA
                </span>

            </div>

            <button onclick="toggleSidebar()"
                    class="hidden md:block text-white text-lg">
                ☰
            </button>

            <button onclick="toggleSidebarMobile()"
                    class="md:hidden text-white text-lg">
                ✕
            </button>

        </div>

        <!-- MENU -->
        <nav class="p-4 space-y-2">

            <a href="/Home/Index" class="menu-item">
                <i class="fa fa-house text-lg"></i>
                <span class="menu-text">Home</span>
            </a>

            <a href="/Home/Produtos" class="menu-item">
                <i class="fa fa-box text-lg"></i>
                <span class="menu-text">Estoque</span>
            </a>

            <a href="/Home/Movimentacoes" class="menu-item">
                <i class="fa fa-clock-rotate-left text-lg"></i>
                <span class="menu-text">Movimentações</span>
            </a>

            <a href="#"
                   id="logoutBtn"
                   class="menu-item hover:bg-red-600 mt-6">

                <i class="fa fa-right-from-bracket text-lg"></i>

                <span class="menu-text">
                    Sair
                </span>

            </a>

        </nav>

    </aside>

    <!-- CONTEÚDO -->
    <div id="content"
         class="ml-0 md:ml-64 transition-all duration-300 min-h-screen">

        <!-- TOPBAR -->
        <header class="bg-white shadow-sm px-6 py-4 flex items-center justify-between">

            <div class="flex items-center gap-4">

                <!-- BOTÃO MOBILE -->
                <button onclick="toggleSidebarMobile()"
                        class="md:hidden text-2xl text-gray-700">

                    ☰

                </button>

                <h1 class="text-xl font-bold text-gray-800">
                    @ViewData["Title"]
                </h1>

            </div>

        </header>

        <!-- BODY -->
        <main class="p-6">
            @RenderBody()
        </main>

    </div>

    <script>

        // =========================
        // 🔐 TOKEN
        // =========================
        const token = localStorage.getItem("token");

        if (!token) {
        window.location.href = "/Home/Login";
        }

        // =========================
        // 🚪 LOGOUT
        // =========================
        document.getElementById("logoutBtn")
        .addEventListener("click", async (e) => {

        e.preventDefault();

        const confirmar = confirm("Deseja sair?");

        if (!confirmar) return;

        await fetch("https://localhost:7004/api/UserAuth/Logout", {
        method: "POST"
        });

        localStorage.removeItem("token");

        window.location.href = "/Home/Login";
        });

        // =========================
        // 🎯 MENU ATIVO
        // =========================
        const links = document.querySelectorAll(".menu-item");

        links.forEach(link => {

        if (link.href === window.location.href) {
        link.classList.add("active");
        }

        });

        // =========================
        // 📦 SIDEBAR DESKTOP
        // =========================
        let collapsed = false;

        function toggleSidebar() {

        const sidebar = document.getElementById("sidebar");

        const content = document.getElementById("content");

        collapsed = !collapsed;

        if (collapsed) {

        sidebar.classList.remove("w-64");

        sidebar.classList.add("w-20");

        sidebar.classList.add("collapsed");

        content.classList.remove("md:ml-64");

        content.classList.add("md:ml-20");

        }
        else {

        sidebar.classList.add("w-64");

        sidebar.classList.remove("w-20");

        sidebar.classList.remove("collapsed");

        content.classList.add("md:ml-64");

        content.classList.remove("md:ml-20");
        }
        }

        // =========================
        // 📱 SIDEBAR MOBILE
        // =========================
        function toggleSidebarMobile() {

        const sidebar = document.getElementById("sidebar");

        const overlay = document.getElementById("overlay");

        if (sidebar.classList.contains("-translate-x-full")) {

        sidebar.classList.remove("-translate-x-full");

        overlay.classList.remove("hidden");

        }
        else {

        sidebar.classList.add("-translate-x-full");

        overlay.classList.add("hidden");
        }
        }

        // =========================
        // 🚀 INIT MOBILE
        // =========================
        if (window.innerWidth < 768) {

        document.getElementById("sidebar")
        .classList.add("-translate-x-full");
        }

        // =========================
        // 🔁 API FETCH
        // =========================
        async function apiFetch(url, options = {}) {

        const token = localStorage.getItem("token");

        const response = await fetch(url, {

        ...options,

        headers: {
        "Content-Type": "application/json",
        "Authorization": "Bearer " + token,
        ...options.headers
        }

        });

        if (response.status === 401) {

        localStorage.removeItem("token");

        window.location.href = "/Home/Login";
        }

        return response;
        }

    </script>

    @RenderSection("Scripts", required: false)

</body>
</html>